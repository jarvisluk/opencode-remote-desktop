{
  "name": "opendot",
  "version": "0.1.0",
  "description": "A macOS host for OpenCode: real desktop and signed-in browser control, live human takeover from any browser, and 24/7 routines.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "macos",
    "computer-use",
    "desktop-automation",
    "accessibility",
    "human-takeover",
    "automation"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "!dist/**/*.map",
    "native"
  ],
  "scripts": {
    "build": "node scripts/build-gui.js",
    "build:native": "node scripts/build-native.js",
    "dev": "node scripts/dev.js",
    "install:macbook": "sh scripts/install-macbook.sh",
    "harness": "node test/stream-harness.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build:pages": "node scripts/build-pages.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "solid-js": "^1.9.19",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.7"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarvisluk/opendot.git"
  },
  "homepage": "https://github.com/jarvisluk/opendot#readme",
  "bugs": {
    "url": "https://github.com/jarvisluk/opendot/issues"
  }
}
