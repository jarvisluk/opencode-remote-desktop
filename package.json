{
  "name": "opencode-remote-desktop",
  "version": "0.1.0",
  "description": "Remote desktop & browser control host for OpenCode across macOS, Windows, and Linux: native WebRTC H.264 streaming, live human takeover, and 24/7 routines.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "macos",
    "windows",
    "linux",
    "computer-use",
    "desktop-automation",
    "webrtc",
    "human-takeover",
    "automation"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist/gui-experimental.cjs",
    "native/README.md",
    "native/bot-host/Cargo.toml",
    "native/bot-host/Cargo.lock",
    "native/bot-host/build.rs",
    "native/bot-host/src"
  ],
  "scripts": {
    "build": "node scripts/build-gui.js",
    "build:native": "node scripts/build-native.js",
    "prepare:host-packages": "node scripts/prepare-host-packages.mjs",
    "dev": "node scripts/dev.js",
    "install:macbook": "sh scripts/install-macbook.sh",
    "harness": "node test/stream-harness.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build:pages": "node scripts/build-pages.js",
    "prepack": "npm run build"
  },
  "optionalDependencies": {
    "@opencode-bot/host-darwin-arm64": "0.1.0",
    "@opencode-bot/host-darwin-x64": "0.1.0",
    "@opencode-bot/host-win32-x64": "0.1.0",
    "@opencode-bot/host-win32-arm64": "0.1.0",
    "@opencode-bot/host-linux-x64": "0.1.0",
    "@opencode-bot/host-linux-arm64": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "solid-js": "^1.9.19",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.7"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarvisluk/opencode-remote-desktop.git"
  },
  "homepage": "https://github.com/jarvisluk/opencode-remote-desktop#readme",
  "bugs": {
    "url": "https://github.com/jarvisluk/opencode-remote-desktop/issues"
  }
}
