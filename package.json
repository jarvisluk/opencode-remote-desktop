{
  "name": "opencode-bot",
  "version": "0.1.0",
  "description": "An always-on macOS host for OpenCode Server: real desktop & signed-in browser control, live Web human takeover, and 24/7 background routines.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-gui.js",
    "build:native": "node scripts/build-native.js",
    "dev": "node scripts/dev.js",
    "install:macbook": "sh scripts/install-macbook.sh",
    "harness": "node test/stream-harness.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "solid-js": "^1.9.19",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.7"
  }
}
